/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/book/pages/*
  Cache-Control: private, max-age=86400

/assets/audio/*
  Cache-Control: private, max-age=86400

/assets/audio/manifest.json
  Cache-Control: no-cache
